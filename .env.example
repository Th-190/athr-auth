APP_DEBUG=false
APP_ENV=local
APP_FAKER_LOCALE=ar_SA
APP_FALLBACK_LOCALE=ar
APP_KEY=
APP_LOCALE=ar
APP_NAME="أثر كربلاء"
APP_URL=http://localhost
APP_TIMEZONE=Asia/Baghdad
# Railway: set APP_URL to the public HTTPS domain and provide DATABASE_URL.
CACHE_STORE=database
CDN_DERIVATIVES_BUCKET=
CDN_URL=
# Set only in a trusted deployment shell for `php artisan make:admin`; leave blank otherwise.
ARCHIVE_ADMIN_EMAIL=
# DATABASE_URL is supported directly for Railway Postgres. DB_* may be used locally.
DB_CONNECTION=pgsql
DB_SSLMODE=require
DB_DATABASE=athr_karbala
DB_HOST=pgsql
DB_PASSWORD=
DB_PORT=5432
DB_USERNAME=postgres
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STACK=single
LARAVEL_API_URL=http://127.0.0.1:8000
MAIL_FROM_ADDRESS=hello@athr.karbala.iq
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=127.0.0.1
MAIL_MAILER=smtp
MAIL_PASSWORD=null
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_USERNAME=null
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=120
# Media object storage. Production uses Supabase's Storage REST API; local/testing uses local disks.
MEDIA_STORAGE_DRIVER=local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLIC_URL="${SUPABASE_URL}"
# Server-only Supabase service_role JWT (never expose it to Vite or the browser).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ORIGINALS_BUCKET=athr-originals
SUPABASE_DERIVATIVES_BUCKET=athr-derivatives
SUPABASE_DOWNLOADS_BUCKET=athr-downloads
RATE_LIMIT_API=60
RATE_LIMIT_CONTRIBUTIONS=20
RATE_LIMIT_LOGIN=5
SANCTUM_EXPIRATION=720
SESSION_DOMAIN=localhost
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1,your-production-host.example.com
VITE_APP_NAME="${APP_NAME}"
VITE_CDN_URL=
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
